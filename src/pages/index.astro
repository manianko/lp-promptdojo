---
// 設計意図：LPのトップページ。LP_SPEC.md §4 のセクションを上から順に差し込む器。
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import Solution from "../components/Solution.astro";
import FeaturePreview from "../components/FeaturePreview.astro";
import Pricing from "../components/Pricing.astro";
import Comparison from "../components/Comparison.astro";
import Story from "../components/Story.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
import { SERVICE_NAME } from "../config";
---

<Layout
  title={`${SERVICE_NAME}｜1日5分、書いて、直されるAI学習アプリ`}
  description="ゲーム感覚で続く、日本語ネイティブのAIトレーニングアプリ。あなたの書いたプロンプトをAIが採点し、その場で改善点を返します。先行登録受付中。"
>
  <main>
    <Hero />
    <Problem />
    <Solution />
    <FeaturePreview />
    <Pricing />
    <Comparison />
    <Story />
    <Faq />
    <FinalCta />
  </main>

  <Footer />
</Layout>
