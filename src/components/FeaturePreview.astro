---
// 設計意図：Solutionで約束した「書いて、直される」を、実際の3画面（レッスン→実技→採点結果）とスキルツリーで具体化する。すべて開発中のイメージである旨を各所に明示し、完成品と誤認させない（LP_SPEC §4-4）。
import { FREE_GRADING_PER_DAY } from "../config";

// モック枠の共通スタイル（3画面で崩さないよう1箇所に集約）
const frameClass =
  "overflow-hidden rounded-2xl bg-white text-slate-900 shadow-xl ring-1 ring-emerald-900/10";
const frameBarClass =
  "flex items-center justify-between border-b border-slate-200 bg-slate-50 px-4 py-2.5";
const mockBadgeClass =
  "rounded-full bg-slate-200 px-2 py-0.5 text-[10px] font-bold tracking-wide text-slate-600";

// 採点結果モックの観点別スコア（すべてサンプル値。実データではない）
const sampleScores = [
  { label: "役割の指定", width: "w-[80%]" },
  { label: "条件の具体性", width: "w-[45%]" },
  { label: "出力形式", width: "w-[60%]" },
];

// スキルツリー（構想）。分野ごとに枝分かれし、進めた分だけ次が開く想定
const skillTree = [
  {
    stage: "STAGE 1",
    label: "基礎：指示の型",
    unlocked: true,
    skills: ["役割を与える", "条件を絞る", "出力形式を指定する"],
  },
  {
    stage: "STAGE 2",
    label: "応用：仕事の中で使う",
    unlocked: false,
    skills: ["メール・議事録", "要約と比較", "資料のたたき台"],
  },
  {
    stage: "STAGE 3",
    label: "発展：自分の型をつくる",
    unlocked: false,
    skills: ["定型プロンプト化", "自分用チェックリスト"],
  },
];
---

<section class="bg-emerald-950 text-emerald-50">
  <div class="mx-auto max-w-5xl px-5 py-16 sm:py-24">
    <h2 class="text-2xl font-bold leading-snug tracking-tight sm:text-3xl">
      1レッスンは、<br class="sm:hidden" />この3画面で終わります。
    </h2>
    <p class="mt-4 text-base leading-relaxed text-emerald-100/90 sm:text-lg">
      解説を読む → 自分で書く → 採点とコメントを受け取る。<br class="hidden sm:inline" />
      この一往復を、1日1回くり返せる形を目指しています。
    </p>
    <p class="mt-4 text-xs leading-relaxed text-amber-300/90">
      ※ 以下の画面はすべて<strong class="font-bold">開発中のイメージ</strong
      >です。実際の画面・機能・数値は変更になる場合があります。
    </p>

    {/* 画面モック3枚 */}
    <ol class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-3 md:gap-6">
      <li>
        <p class="mb-3 text-sm font-bold tracking-wide text-emerald-300">① レッスン</p>
        <div class={frameClass}>
          <div class={frameBarClass} aria-hidden="true">
            <span class="text-xs font-bold text-slate-500">Lesson 04</span>
            <span class={mockBadgeClass}>開発中のイメージ</span>
          </div>
          <div class="p-4" aria-hidden="true">
            <div class="h-1.5 w-full overflow-hidden rounded-full bg-slate-200">
              <div class="h-full w-[35%] rounded-full bg-emerald-600"></div>
            </div>
            <p class="mt-4 text-base font-bold leading-snug">指示は「役割」から始める</p>
            <div class="mt-3 space-y-2">
              <div class="h-2.5 w-full rounded bg-slate-200"></div>
              <div class="h-2.5 w-11/12 rounded bg-slate-200"></div>
              <div class="h-2.5 w-3/4 rounded bg-slate-200"></div>
            </div>
            <div class="mt-4 rounded-lg bg-emerald-50 p-3 ring-1 ring-emerald-100">
              <p class="text-[11px] font-bold text-emerald-700">例</p>
              <p class="mt-1 text-xs leading-relaxed text-slate-600">
                「あなたは経験10年の広報担当です。」
              </p>
            </div>
            <div
              class="mt-4 rounded-lg bg-emerald-950 px-4 py-2.5 text-center text-sm font-bold text-amber-400"
            >
              実技に進む
            </div>
          </div>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-emerald-100/80">
          考え方を短く読みます。1画面ぶんの分量に抑える設計です。
        </p>
      </li>

      <li>
        <p class="mb-3 text-sm font-bold tracking-wide text-emerald-300">② 実技</p>
        <div class={frameClass}>
          <div class={frameBarClass} aria-hidden="true">
            <span class="text-xs font-bold text-slate-500">実技</span>
            <span class={mockBadgeClass}>開発中のイメージ</span>
          </div>
          <div class="p-4" aria-hidden="true">
            <p class="text-[11px] font-bold text-emerald-700">お題</p>
            <p class="mt-1 text-xs leading-relaxed text-slate-600">
              納期の遅れを伝えるメールの下書きを、AIに書かせるプロンプトを作ってください。
            </p>
            <div class="mt-3 rounded-lg border border-slate-300 bg-white p-3">
              <p class="text-xs leading-relaxed text-slate-800">
                取引先に送るお詫びのメールを書いて。丁寧な感じでお願いします。
              </p>
              <div class="mt-2 h-2.5 w-1/3 rounded bg-slate-100"></div>
            </div>
            <p class="mt-2 text-right text-[10px] text-slate-400">
              本日の無料採点：残り2 / {FREE_GRADING_PER_DAY}回
            </p>
            <div
              class="mt-3 rounded-lg bg-amber-400 px-4 py-2.5 text-center text-sm font-bold text-emerald-950"
            >
              採点する
            </div>
          </div>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-emerald-100/80">
          読んで終わりにせず、その場で自分の言葉で書きます。
        </p>
      </li>

      <li>
        <p class="mb-3 text-sm font-bold tracking-wide text-emerald-300">③ 採点結果</p>
        <div class={frameClass}>
          <div class={frameBarClass} aria-hidden="true">
            <span class="text-xs font-bold text-slate-500">採点結果</span>
            <span class={mockBadgeClass}>開発中のイメージ</span>
          </div>
          <div class="p-4" aria-hidden="true">
            <div class="flex items-baseline gap-2">
              <span class="text-4xl font-bold tabular-nums text-emerald-800">62</span>
              <span class="text-sm font-bold text-slate-500">点</span>
              <span class="ml-auto text-[10px] text-slate-400">サンプル表示</span>
            </div>
            <div class="mt-4 space-y-2.5">
              {
                sampleScores.map((score) => (
                  <div>
                    <p class="text-[11px] text-slate-500">{score.label}</p>
                    <div class="mt-1 h-1.5 w-full overflow-hidden rounded-full bg-slate-200">
                      <div class={`h-full rounded-full bg-emerald-600 ${score.width}`} />
                    </div>
                  </div>
                ))
              }
            </div>
            <div class="mt-4 rounded-lg bg-amber-50 p-3 ring-1 ring-amber-200">
              <p class="text-[11px] font-bold text-amber-700">改善コメント</p>
              <p class="mt-1 text-xs leading-relaxed text-slate-700">
                「丁寧な感じ」を、宛先・遅延日数・代替案の3点に置き換えると、直せる下書きになります。
              </p>
            </div>
          </div>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-emerald-100/80">
          点数だけでなく、どこをどう直すかが文章で返ります。
        </p>
      </li>
    </ol>

    {/* スキルツリー図 */}
    <div class="mt-16 border-t border-emerald-800/60 pt-12 sm:mt-20">
      <h3 class="text-xl font-bold leading-snug tracking-tight sm:text-2xl">
        レッスンは、枝分かれしていきます。
      </h3>
      <p class="mt-3 text-sm leading-relaxed text-emerald-100/80 sm:text-base">
        基礎の型を身につけたあと、使う場面ごとに分かれていく構成を予定しています。
      </p>
      <p class="mt-3 text-xs leading-relaxed text-amber-300/90">
        ※ 下図は構想中のカリキュラム案です。単元名・順序は変更になる場合があります。
      </p>

      <ol class="mt-8">
        {
          skillTree.map((stage, index) => (
            <li class="relative pb-8 pl-8 last:pb-0">
              {index < skillTree.length - 1 && (
                <span
                  class="absolute left-[7px] top-4 h-full w-px bg-emerald-700"
                  aria-hidden="true"
                />
              )}
              <span
                class={`absolute left-0 top-2 size-4 rounded-full ring-4 ring-emerald-950 ${
                  stage.unlocked ? "bg-amber-400" : "bg-emerald-700"
                }`}
                aria-hidden="true"
              />
              <p class="text-xs font-bold tracking-widest text-emerald-400">{stage.stage}</p>
              <p class="mt-1 flex items-center gap-2 text-base font-bold sm:text-lg">
                {stage.label}
                {!stage.unlocked && (
                  <svg
                    class="size-4 text-emerald-500"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    role="img"
                    aria-label="この先の単元"
                  >
                    <rect x="4" y="10" width="16" height="10" rx="2" />
                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                  </svg>
                )}
              </p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {stage.skills.map((skill) => (
                  <li
                    class={`rounded-lg px-3 py-1.5 text-xs ring-1 sm:text-sm ${
                      stage.unlocked
                        ? "bg-emerald-900 text-emerald-50 ring-emerald-700"
                        : "bg-emerald-950 text-emerald-200/70 ring-emerald-800"
                    }`}
                  >
                    {skill}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
